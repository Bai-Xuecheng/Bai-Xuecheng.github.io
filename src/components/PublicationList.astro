---
import { profile } from '../data/site.js';
const { items } = Astro.props;
const isProfileAuthor = (author) => author === profile.name || author === '白雪城';
---
<div class="publication-list">
  {items.map((paper) => (
    <article class="publication-item">
      {paper.image ? (
        <img class="publication-image" src={paper.image} alt={`First page of ${paper.title}`} width="240" height="311" loading="lazy" />
      ) : (
        <div class="publication-image publication-image-pending" aria-label="Paper cover not available yet">Cover pending</div>
      )}
      <div class="publication-year">{paper.year}</div>
      <div class="publication-main">
        <h3>{paper.title}</h3>
        <p class="publication-authors">
          {paper.authors.map((author, index) => (
            <>
              {isProfileAuthor(author) ? <strong>{author}{paper.equalContributors?.includes(author) ? '*' : ''}</strong> : <>{author}{paper.equalContributors?.includes(author) ? '*' : ''}</>}
              {index < paper.authors.length - 1 ? ', ' : ''}
            </>
          ))}
          {paper.equalContribution && <span class="contribution-note"> * Equal contribution</span>}
        </p>
        <p class="publication-venue">{paper.venue}</p>
        {paper.abstract && <p class="publication-abstract"><strong>{/[\u3400-\u9fff]/u.test(paper.title) ? '摘要' : 'Abstract'}:</strong> {paper.abstract}</p>}
        <div class="link-row">
          {paper.links.map((link) => (
            <a class="text-link" href={link.href} target="_blank" rel="noreferrer">{link.label}<span aria-hidden="true"> ↗</span></a>
          ))}
        </div>
      </div>
    </article>
  ))}
</div>
